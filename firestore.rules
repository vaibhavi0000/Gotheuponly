rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /calculator_products/{productId} {
      allow read, write: if true;
    }
    match /calculator_categories/{categoryId} {
      allow read, write: if true;
    }
    match /calculator_deleted_ids/{deletedId} {
      allow read, write: if true;
    }
    match /calculator_audit_logs/{logId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
