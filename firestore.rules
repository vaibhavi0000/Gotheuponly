rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /tsukuri_products/{productId} {
      allow read, write: if true;
    }
    match /live_activity/{activityId} {
      allow read, write: if true;
    }
    match /orders/{orderId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
